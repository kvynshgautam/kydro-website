{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/web", "destination": "/web.html" },
    { "source": "/download/apk", "destination": "/downloads/KYDRO.apk" },
    { "source": "/api/updates", "destination": "/update.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

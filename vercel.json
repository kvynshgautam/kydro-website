{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/apk",
      "destination": "https://github.com/kvynshgautam/kydro-website/releases/latest/download/KYDRO-latest.apk",
      "permanent": false
    },
    {
      "source": "/downloads/:path*",
      "destination": "https://github.com/kvynshgautam/kydro-website/releases/latest/download/KYDRO-latest.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/web", "destination": "/web.html" },
    { "source": "/api/updates", "destination": "/update.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
